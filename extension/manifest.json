{
  "manifest_version": 3,
  "name": "Pravaha",
  "version": "0.2.1",
  "description": "A relevance-ranked reader on top of Miniflux. It learns from what you open, save and dismiss, and keeps two machines in step.",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png" },
  "browser_specific_settings": {
    "gecko": {
      "id": "pravaha@agravaani",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "background": { "scripts": ["background.js"], "type": "module" },
  "permissions": ["storage", "unlimitedStorage", "alarms", "tabs", "bookmarks", "history"],
  "host_permissions": ["https://reader.miniflux.app/*", "https://myfiles.fastmail.com/*", "https://api.raindrop.io/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "action": { "default_title": "Open Pravaha", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" } },
  "commands": { "_execute_action": { "suggested_key": { "default": "Alt+Shift+R" }, "description": "Open Pravaha" } }
}
